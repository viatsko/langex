{
  "name": "langex",
  "private": true,
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:start": "docker-compose up -d db",
    "db:stop": "docker-compose down",
    "db:migrate": "yarn workspace langex-backend db:migrate",
    "db:studio": "yarn workspace langex-backend db:studio"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  }
}
