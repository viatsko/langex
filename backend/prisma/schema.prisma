generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GrammarCard {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String   @db.Text
  examples    Json     @default("[]")
  category    String
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("grammar_cards")
}

model DictionaryEntry {
  id                  String   @id @default(cuid())
  englishWord         String   @map("english_word")
  russianWord         String   @map("russian_word")
  turkishWord         String   @map("turkish_word")
  partOfSpeech        String?  @map("part_of_speech")
  pronunciation       String?
  morphologyBreakdown Json?    @map("morphology_breakdown")
  isPhrase            Boolean  @default(false) @map("is_phrase")
  examples            Json     @default("[]")
  tags                String[] @default([])
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("dictionary_entries")
}

model AiConversation {
  id        String   @id @default(cuid())
  messages  Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_conversations")
}
