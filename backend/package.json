{
  "name": "langex-backend",
  "version": "1.0.0",
  "description": "Langex API backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../.env -- prisma db push",
    "db:studio": "dotenv -e ../.env -- prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@prisma/client": "6.19.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3"
  }
}
